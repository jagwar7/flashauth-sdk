{
  "compilerOptions": {
    "target": "es6",
    "module": "commonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true

  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}